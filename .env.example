# Copy to .env (never committed) and fill in what you have. Every key here is free; empty = that source stays off
# and its factors show "blockiert (Schlüssel fehlt)" instead of failing.

# --- US macro and markets
FRED_API_KEY=            # https://fred.stlouisfed.org/docs/api/api_key.html  (ALFRED first releases)
BLS_API_KEY=             # https://data.bls.gov/registrationEngine/  (works without, but only 25 queries/day)
BEA_API_KEY=             # https://apps.bea.gov/API/signup/
CENSUS_API_KEY=          # https://api.census.gov/data/key_signup.html
EIA_API_KEY=             # https://www.eia.gov/opendata/register.php
USDA_NASS_API_KEY=       # https://quickstats.nass.usda.gov/api
CONGRESS_API_KEY=        # https://api.congress.gov/sign-up/

# --- SEC EDGAR: no key, but the SEC requires a User-Agent with name and contact e-mail
SEC_USER_AGENT=          # e.g. "Max Muster max@example.com"

# --- Market data free tiers (limits respected via cache + backoff)
FINNHUB_API_KEY=         # https://finnhub.io/register
ALPHAVANTAGE_API_KEY=    # https://www.alphavantage.co/support/#api-key
TWELVEDATA_API_KEY=      # https://twelvedata.com/register
MASSIVE_API_KEY=         # https://massive.com (formerly Polygon.io)
TIINGO_API_KEY=          # https://www.tiingo.com/account/api/token
EODHD_API_KEY=           # https://eodhd.com/register
COINGECKO_API_KEY=       # https://www.coingecko.com/en/api (free demo key)

# --- News, social, attention, research
ACLED_API_KEY=           # https://acleddata.com (research access)
ACLED_EMAIL=
REDDIT_CLIENT_ID=        # https://www.reddit.com/prefs/apps (script app, non-commercial)
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=         # https://console.cloud.google.com (YouTube Data API v3)
NOAA_TOKEN=              # https://www.ncdc.noaa.gov/cdo-web/token
USPTO_API_KEY=           # https://patentsview.org (PatentsView API key)
COURTLISTENER_TOKEN=     # https://www.courtlistener.com/sign-in/
OPENFDA_API_KEY=         # optional, raises the openFDA limit

# --- Optional paid sources later (adapters prepared, empty until a key is set)
X_BEARER_TOKEN=
CONSENSUS_API_KEY=
BORROW_FEE_API_KEY=
CRSP_USER=
COMPUSTAT_USER=

# --- AI (optional, costs money per question; free alternative: Claude Code + MCP)
ANTHROPIC_API_KEY=

# --- Website storage (optional; see Konto → Verbindung)
GITHUB_TOKEN=
WORKSPACE_REPO=
COMMUNITY_REPO=
